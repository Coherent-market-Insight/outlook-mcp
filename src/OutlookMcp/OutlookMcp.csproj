<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>outlook-mcp</AssemblyName>
    <RootNamespace>OutlookMcp</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <NoWarn>CA1416</NoWarn>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Version>1.0.0</Version>
    <Authors>Coherent Market Insights</Authors>
    <Company>Coherent Market Insights Pvt. Ltd.</Company>
    <Product>Outlook MCP</Product>
    <Copyright>Copyright (c) Coherent Market Insights Pvt. Ltd.</Copyright>
    <Description>MCP server for the Microsoft Outlook desktop client on Windows (mail, calendar, contacts, tasks).</Description>
    <RepositoryUrl>https://github.com/Coherent-market-Insight/outlook-mcp</RepositoryUrl>

    <!-- Lean runtime: one process, one file, small memory footprint. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <SelfContained>true</SelfContained>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageReference Include="ModelContextProtocol" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
    <InternalsVisibleTo Include="OutlookMcp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\skills\outlook\SKILL.md" LogicalName="skill/SKILL.md" />
  </ItemGroup>

</Project>
